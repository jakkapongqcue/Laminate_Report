{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "overrides": [
    {
      "files": "*.vue",
      "options": {
        "singleQuote": true,
        "semi": false
      }
    },
    {
      "files": "server.js",
      "options": {
        "printWidth": 100
      }
    },
    {
      "files": "reportProcessor.js",
      "options": {
        "printWidth": 100
      }
    },
    {
      "files": "chartProcessor.js",
      "options": {
        "printWidth": 100
      }
    },
    {
      "files": "common.js",
      "options": {
        "printWidth": 190
      }
    }
  ]
}
